<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_DueDate_Revisit</name>
        <label>기한·재방문 세팅</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.DueDate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_DueDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.RequiresRevisit__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_RequiresRevisit</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>fx_DueDate</name>
        <dataType>Date</dataType>
        <expression
    >BLANKVALUE({!$Record.DueDate__c}, {!$Flow.CurrentDate} + {!fx_DueDays})</expression>
    </formulas>
    <formulas>
        <name>fx_DueDays</name>
        <dataType>Number</dataType>
        <expression
    >IF(TEXT({!$Record.InspectionResult__r.Category__c}) = &quot;위생&quot;, 3, 7)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fx_RequiresRevisit</name>
        <dataType>Boolean</dataType>
        <expression
    >AND(TEXT({!$Record.InspectionResult__r.Category__c}) = &quot;위생&quot;, {!$Record.InspectionResult__r.IsRequired__c})</expression>
    </formulas>
    <interviewLabel
  >시정조치 기한 자동설정 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>시정조치 기한 자동설정</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_DueDate_Revisit</targetReference>
        </connector>
        <object>CorrectiveAction__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
