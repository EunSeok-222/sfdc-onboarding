<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ReinspectionRequiresOriginal</fullName>
    <active>true</active>
    <description>26-10-06 재점검은 원 점검 지정 필수 by Kai</description>
    <errorConditionFormula>AND(
  RecordType.DeveloperName = &quot;Reinspection&quot;,
  ISBLANK(OriginalInspection__c)
)</errorConditionFormula>
    <errorDisplayField>OriginalInspection__c</errorDisplayField>
    <errorMessage>재점검은 원래 점검을 지정해야 합니다.</errorMessage>
</ValidationRule>
